//@version=6
// =============================================================================
// Strat v5 Companion — v10
// -----------------------------------------------------------------------------
// The on-chart twin of the v5 scanner + the F2D-Deep frozen tracker.
//
//   * Strat bar labels (1 / 2U / 2D / 3)              -> strat.label_bars
//   * BOTH nominators watched at once (4H and 1D)     -> scanner.py Gate 1
//   * Inside-bar arming off the last CLOSED setup bar -> levels.arm_inside_bar
//   * Failed 2 exactly as the scanner defines it: the FORMING setup bar pokes
//     through the prior CLOSED bar's extreme and price comes back inside.
//     Trigger = the prior bar's extreme, stop = the poke extreme. An F2 is
//     named for the move that FAILED, not for the trade it produces:
//         F2D = failed to go DOWN (poke below the prior low reclaimed) -> LONG
//         F2U = failed to go UP   (poke above the prior high lost)     -> SHORT
//     Same convention as f2d_tracker.py, so F2D-Deep is consistently a long.
//                                                     -> levels.arm_failed_two
//   * Gate 2a minimum viable risk (0.15% of price)    -> magnitude.MIN_RISK_PCT
//   * Gate 2: nearest untouched gating rung >= min R  -> magnitude.evaluate
//   * Gate 3: 4H+1D continuity; Gate 3b: FTFC >= min  -> magnitude.evaluate
//   * Scale-out geometry: trigger, stop, +1R          -> alerting._scale_plan
//   * Chart-TF Tier-2 close-through markers + alerts  -> levels.evaluate_tiers
//   * F2D-Deep (SPY/QQQ/IWM only): daily 2D, undercut >= 0.35 x ATR14, green
//     close in the top 40% of its range -> BUY next open, stop = signal low,
//     half at +1R -> breakeven, runner to prior high, 2-day time stop.
//                                                     -> f2d_tracker.py
//
// Labels landing on the same price are MERGED into one line ("a  ·  b")
// instead of printing on top of each other -- overlap is structural whenever
// a setup edge IS a higher-TF prior extreme, so merging, not luck, fixes it.
//
// NON-REPAINT: every higher-TF read uses confirmed history (lookahead_off).
// F2 arms and disarms INTRABAR by design -- it is the scanner's only mid-bar
// formation, and the whole point is catching the trap while it is live.
// =============================================================================

indicator("Strat v5 Companion", overlay = true,
     max_lines_count = 500, max_labels_count = 500, max_boxes_count = 50)

// Gate 2a: risk below this fraction of price is inside the spread, not a trade.
MINRISK = 0.0015

// ---------------------------------------------------------------- inputs -----
gSetup = "Setups"
use4H = input.bool(true, "4H setups", group = gSetup, inline = "tf")
use1D = input.bool(true, "1D setups", group = gSetup, inline = "tf",
     tooltip = "The scanner watches BOTH nominators every scan. Untick one to focus the chart.")
showLabels  = input.bool(true,  "Strat bar labels (chart TF)", group = gSetup)
barLabelN   = input.int(10,     "Show labels & T2 markers: last N bars (0 = all)", group = gSetup, minval = 0)
onlyInside  = input.bool(false, "  └ only label inside bars (1)", group = gSetup)
labelSizeIn = input.string("Small", "Label / arrow size", group = gSetup,
     options = ["Tiny", "Small", "Normal", "Large", "Huge"])
minRunwayR  = input.float(2.0,  "Min runway (R) to call it valid", group = gSetup, step = 0.5,
     tooltip = "Gate 2. Still gates the T2 marker and the alert -- it just no longer draws a line.")
maxSessExt  = input.float(0.52, "Gate 4: session spent above this %", group = gSetup,
     minval = 0.0, maxval = 1.0, step = 0.01,
     tooltip = "Mirrors magnitude.MAX_SESSION_EXT in the scanner. Once the session has "
             + "travelled this far (|price - open| / range so far) a WITH-the-move entry has "
             + "historically returned ~+0.05R against ~+0.72R for the rest, so the scanner "
             + "suppresses that alert. The EXT row turns red at this level. It does NOT argue "
             + "against a counter-move trade -- that was the strongest bucket in the replay.")

gForm = "Formations (what arms a trigger)"
armInside = input.bool(true,  "Inside bar (x-1-2) — both edges", group = gForm)
armF2     = input.bool(true,  "Failed 2 — mid-bar trap (F2D long / F2U short)", group = gForm,
     tooltip = "The scanner's Family B. The FORMING 4H/1D bar pokes through the prior closed "
             + "bar's extreme and price falls back inside: trapped traders. Trigger is the "
             + "prior bar's extreme (a close back through it), stop is the poke extreme. "
             + "Arms and disarms live within the bar — exactly like the scanner.")
armOut    = input.bool(false, "3-2 outside bar (NOT in the scanner)", group = gForm,
     tooltip = "Extra formation the Telegram pipeline does not alert. Off keeps the chart "
             + "showing only what the scanner can send.")
armCont   = input.bool(false, "2-2 continuation (NOT in the scanner)", group = gForm)

gDeep = "F2D-Deep (frozen daily strategy)"
showDeep = input.bool(true, "F2D-Deep plan (SPY / QQQ / IWM only)", group = gDeep,
     tooltip = "Frozen 2026-07-25, mirrors f2d_tracker.py: daily 2D against the prior day "
             + "(low < prior low, high <= prior high), undercut depth >= 0.35 x ATR14 "
             + "(ATR through the prior day), close green in the top 40% of the range. "
             + "BUY next open; stop = signal low; half off at +1R, stop to breakeven; "
             + "runner targets the prior day's high; time stop close of the 2nd session "
             + "after entry. Skip if the open gaps beyond stop or target. The plan lines "
             + "appear once the entry session's daily bar exists and stay up for the "
             + "3-session trade window.")
deepAllTF = input.bool(false, "  └ on intraday charts too", group = gDeep,
     tooltip = "F2D-Deep is a DAILY swing plan. Off draws it only on 1D and higher, where it is "
             + "actionable, instead of adding lines to an execution chart.")
showManage = input.bool(false, "  └ draw +1R / runner lines", group = gDeep,
     tooltip = "The +1R-to-breakeven and runner levels only matter once you are IN.")
compactLbl = input.bool(true,  "  └ compact labels (drop the repeated price)", group = gDeep)
drawLen    = input.int(60,     "  └ line length (bars back)", group = gDeep, minval = 10)

gFtfc = "FTFC continuity (Gate 3b)"
showFTFC    = input.bool(true,  "Show FTFC table", group = gFtfc)
tblPos      = input.string("Bottom Right", "Table position", group = gFtfc,
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"])
minFtfc     = input.int(4, "Min FTFC aligned (gate)", group = gFtfc, minval = 0, maxval = 5)
tblSizeIn   = input.string("Small", "Table text size", group = gFtfc, options = ["Tiny", "Small", "Normal", "Large", "Huge"])

gSeq = "Context table"
showSeq     = input.bool(true, "Show context table", group = gSeq,
     tooltip = "Developing 4H and 1D sequences (e.g. 3 - 1 - 2D) + chart-TF choppiness, "
             + "relative volume, and current range vs ATR.")
seqPos      = input.string("Top Right", "Table position", group = gSeq,
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right", "Middle Left"])
chopLen     = input.int(14, "Choppiness length", group = gSeq, minval = 2)
volLen      = input.int(20, "Volume-average length", group = gSeq, minval = 2)
atrLen      = input.int(14, "ATR length", group = gSeq, minval = 1)
rvolAlertX  = input.float(1.5, "RVOL alert threshold (x)", group = gSeq, minval = 1.0, step = 0.1,
     tooltip = "Fires once, at the check time below, if session volume pace is at least this. "
             + "At 10:30 a 1.5x reading has historically finished the day >=1.5x about 62% of the "
             + "time and >=1.2x about 91%, against a 6% base rate. It says the day is BUSY, not "
             + "which way it is going -- RVOL correlates with range, not with direction.")
rvolAlertMin= input.int(630, "RVOL alert check time (min from midnight)", group = gSeq,
     tooltip = "630 = 10:30 ET. Earlier is less reliable: 09:45 gives 51% instead of 62%.")

gT2 = "Tier-2 confirmation (arrows)"
showT2      = input.bool(true,  "Mark bar-close through trigger", group = gT2,
     tooltip = "Marks where a bar CLOSES through an armed trigger, on the chart's own "
             + "timeframe. On a <=15m chart this is the true 15m Tier 2.")
t2Gated     = input.bool(true,  "  └ only GATED Tier-2 (match scanner)", group = gT2,
     tooltip = "On: a T2 only prints if the setup also passed min risk, nearest rung >= "
             + "min R, 4H+1D continuity, and FTFC >= min — what the scanner would alert. "
             + "Off shows every raw cross (noisy).")

cBull = input.color(color.new(#3fe08a, 0), "Bull", group = "Colors", inline = "c")
cBear = input.color(color.new(#ff6b62, 0), "Bear", group = "Colors", inline = "c")
cAmber= input.color(color.new(#ffc043, 0), "Scale", group = "Colors", inline = "c")
cDim  = input.color(color.new(#7f93a8, 0), "Dim",  group = "Colors", inline = "c")
cDeep = input.color(color.new(#26c6da, 0), "Deep", group = "Colors", inline = "c")

// One size selector shared by bar labels, level labels, and T2 arrows.
f_size(s) => s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.huge
labelSize = f_size(labelSizeIn)
tblSize   = f_size(tblSizeIn)

// ------------------------------------------------------- strat bar label -----
// Relative to the PRIOR bar. Same four cases as strat.label_bars.
f_label(h, l, ph, pl) =>
    up = h > ph
    dn = l < pl
    up and dn ? "3" : up ? "2U" : dn ? "2D" : "1"

barLbl = f_label(high, low, high[1], low[1])
inLabelWindow = barLabelN == 0 or bar_index > last_bar_index - barLabelN
passType      = not onlyInside or barLbl == "1"
if showLabels and barstate.isconfirmed and inLabelWindow and passType
    isDn = barLbl == "2D"
    col  = barLbl == "1" ? cAmber : barLbl == "3" ? color.new(#c4b5fd, 0) :
         barLbl == "2U" ? cBull : cBear
    label.new(bar_index, isDn ? high : low,
         text = barLbl,
         style = isDn ? label.style_label_down : label.style_label_up,
         color = color.new(color.black, 100), textcolor = col, size = labelSize)

// --------------------------------------------- higher-timeframe reads --------
// One confirmed-history tuple per timeframe: prior-closed high/low, the live
// (forming) high/low, and the forming close/open (for continuity).
f_tf(tf) =>
    request.security(syminfo.tickerid, tf,
         [high[1], low[1], high, low, close, open],
         lookahead = barmerge.lookahead_off)

[h1_60,  l1_60,  hf_60,  lf_60,  c_60,  o_60 ] = f_tf("60")
[h1_120, l1_120, hf_120, lf_120, c_120, o_120] = f_tf("120")
[h1_240, l1_240, hf_240, lf_240, c_240, o_240] = f_tf("240")
[h1_D,   l1_D,   hf_D,   lf_D,   c_D,   o_D  ] = f_tf("D")
[h1_W,   l1_W,   hf_W,   lf_W,   c_W,   o_W  ] = f_tf("W")

// Each nominator needs three closed bars of history to name its pattern.
f_setup(tf) =>
    request.security(syminfo.tickerid, tf,
         [high[1], low[1], high[2], low[2], high[3], low[3], high, low],
         lookahead = barmerge.lookahead_off)

[h1_4s, l1_4s, h2_4s, l2_4s, h3_4s, l3_4s, hf_4s, lf_4s] = f_setup("240")
[h1_Ds, l1_Ds, h2_Ds, l2_Ds, h3_Ds, l3_Ds, hf_Ds, lf_Ds] = f_setup("D")

lab4 = f_label(h1_4s, l1_4s, h2_4s, l2_4s)      // last CLOSED 4H bar's label
labD = f_label(h1_Ds, l1_Ds, h2_Ds, l2_Ds)      // last CLOSED 1D bar's label

pat4 = h2_4s > h3_4s and l2_4s < l3_4s ? "3-1-2" : (h2_4s > h3_4s or l2_4s < l3_4s) ? "2-1-2" : "1-1-2"
patD = h2_Ds > h3_Ds and l2_Ds < l3_Ds ? "3-1-2" : (h2_Ds > h3_Ds or l2_Ds < l3_Ds) ? "2-1-2" : "1-1-2"

// ------------------------------------------------------- arming, per TF ------
// One armed level per SIDE per TF, picked with F2 priority: while a trap is
// live it is the actionable formation (the scanner flags its Tier 1 as the
// hot alert), so it wins the side's display over the structure arms.
//
//   Family A (structure, off the CLOSED bar): inside "1" arms both edges;
//     3-2 / 2-2 cont are optional extras the scanner does not send.
//     Trigger = closed bar's extreme, stop = its other edge.
//   Family B (F2, off the FORMING bar): trigger = prior CLOSED bar's extreme,
//     stop = the forming bar's poke extreme. Risk is the poke depth, NOT the
//     bar range -- this is what makes F2 geometry different from x-1-2.
f_armSide(lab1c, h1, l1, hf, lf, patName) =>
    f2u = armF2 and hf > h1 and close <= h1     // failed 2U: poked above the prior high, back inside -> SHORT
    f2d = armF2 and lf < l1 and close >= l1     // failed 2D: poked below the prior low,  back inside -> LONG
    ins = armInside and lab1c == "1"
    out = armOut and lab1c == "3"
    cB  = armCont and lab1c == "2U"
    cS  = armCont and lab1c == "2D"
    armB  = f2d or ins or out or cB
    trigB = f2d ? l1 : h1
    stopB = f2d ? lf : l1
    patB  = f2d ? "F2D" : ins ? patName : out ? "3-2U" : "2U-2U"
    armS  = f2u or ins or out or cS
    trigS = f2u ? h1 : l1
    stopS = f2u ? hf : h1
    patS  = f2u ? "F2U" : ins ? patName : out ? "3-2D" : "2D-2D"
    [armB, trigB, stopB, patB, armS, trigS, stopS, patS]

[aB0, aTB, aSB, aPB, aS0, aTS, aSS, aPS] = f_armSide(lab4, h1_4s, l1_4s, hf_4s, lf_4s, pat4)
[bB0, bTB, bSB, bPB, bS0, bTS, bSS, bPS] = f_armSide(labD, h1_Ds, l1_Ds, hf_Ds, lf_Ds, patD)
aB = aB0 and use4H
aS = aS0 and use4H
bB = bB0 and use1D
bS = bS0 and use1D

// Per-side risk (1R). F2 risk is the poke depth; structure risk is the range.
aRB = aTB - aSB
aRS = aSS - aTS
bRB = bTB - bSB
bRS = bSS - bTS

// ------------------------------------------- runway: untouched HTF rungs ------
// A rung is the prior-closed extreme of a higher TF that the FORMING bar on
// that TF has NOT yet traded through.
f_untouchedHi(prior, form) => form < prior          // forming high hasn't exceeded it
f_untouchedLo(prior, form) => form > prior          // forming low hasn't undercut it

// Nearest untouched GATING rung (scanner Gate 2). Rungs below the setup TF do
// not gate: a 4H setup gates on 4H/1D/1W, a 1D setup only on 1D/1W. The
// NEAREST rung is the realistic first target, so it is the one that must be
// worth the trip. Sentinel 1e9 when no rung exists ("no runway" fails).
f_nearUp(trig, risk, incl4) =>
    r4 = incl4 and f_untouchedHi(h1_240, hf_240) and h1_240 > trig ? (h1_240 - trig) / risk : na
    rd = f_untouchedHi(h1_D, hf_D) and h1_D > trig ? (h1_D - trig) / risk : na
    rw = f_untouchedHi(h1_W, hf_W) and h1_W > trig ? (h1_W - trig) / risk : na
    math.min(nz(r4, 1e9), nz(rd, 1e9), nz(rw, 1e9))
f_nearDn(trig, risk, incl4) =>
    r4 = incl4 and f_untouchedLo(l1_240, lf_240) and l1_240 < trig ? (trig - l1_240) / risk : na
    rd = f_untouchedLo(l1_D, lf_D) and l1_D < trig ? (trig - l1_D) / risk : na
    rw = f_untouchedLo(l1_W, lf_W) and l1_W < trig ? (trig - l1_W) / risk : na
    math.min(nz(r4, 1e9), nz(rd, 1e9), nz(rw, 1e9))

aNB = f_nearUp(aTB, aRB, true)
aNS = f_nearDn(aTS, aRS, true)
bNB = f_nearUp(bTB, bRB, false)
bNS = f_nearDn(bTS, bRS, false)

// Gate 2a (min viable risk) + Gate 2 (nearest gating rung), per side per TF.
f_ok(armed, trig, risk, near) =>
    armed and risk > 0 and trig > 0 and risk / trig >= MINRISK and near >= minRunwayR and near < 1e8

okAB = f_ok(aB, aTB, aRB, aNB)
okAS = f_ok(aS, aTS, aRS, aNS)
okBB = f_ok(bB, bTB, bRB, bNB)
okBS = f_ok(bS, bTS, bRS, bNS)

// --------------------------------------------------------- FTFC continuity ----
f_dir(c, o) => c > o ? 1 : c < o ? -1 : 0
d60  = f_dir(c_60,  o_60)
d120 = f_dir(c_120, o_120)
d240 = f_dir(c_240, o_240)
dD   = f_dir(c_D,   o_D)
dW   = f_dir(c_W,   o_W)

// Aligned count for a given trade direction (+1 bull / -1 bear).
f_aligned(dirSign) =>
    (d60 == dirSign ? 1 : 0) + (d120 == dirSign ? 1 : 0) + (d240 == dirSign ? 1 : 0) +
     (dD == dirSign ? 1 : 0) + (dW == dirSign ? 1 : 0)

// ---------------------------------------------------------- F2D-Deep ----------
// Frozen rules from f2d_tracker.py, computed on CONFIRMED daily bars. The
// signal is detectable the moment the entry session's daily bar opens (the
// signal day is then [1]); the plan stays drawn through the 3-session window.
f_deepCalc() =>
    atrS  = ta.sma(ta.tr(true), 14)             // tracker uses a plain rolling mean of TR
    rng   = high[1] - low[1]
    is2d  = low[1] < low[2] and high[1] <= high[2]
    depth = atrS[2] > 0 ? (low[2] - low[1]) / atrS[2] : 0.0
    green = close[1] > open[1] and rng > 0 and (close[1] - low[1]) / rng >= 0.60
    sig   = is2d and green and depth >= 0.35
    since = ta.barssince(sig)
    stopP = ta.valuewhen(sig, low[1],  0)       // signal-day low
    tgtP  = ta.valuewhen(sig, high[2], 0)       // prior day's high (runner)
    entry = ta.valuewhen(sig, open,    0)       // entry session's open
    [since, stopP, tgtP, entry]

[dSince, dStop, dTgt, dEntry] = request.security(syminfo.tickerid, "D", f_deepCalc(),
     lookahead = barmerge.lookahead_off)

deepSym    = syminfo.ticker == "SPY" or syminfo.ticker == "QQQ" or syminfo.ticker == "IWM"
// F2D-Deep is a DAILY swing plan; on an execution chart its four lines are
// context you cannot act on, so it is drawn on 1D and higher unless asked for.
deepTF     = deepAllTF or timeframe.in_seconds(timeframe.period) >= timeframe.in_seconds("D")
deepActive = showDeep and deepSym and deepTF and not na(dSince) and dSince <= 2 and not na(dStop) and not na(dEntry)
deepSkip   = deepActive and (dEntry <= dStop or dEntry >= dTgt)   // gap rule: stand aside
deepR      = dEntry - dStop

// ------------------------------------------------ session extension (Gate 4) --
// The SAME number magnitude.session_state() computes, read off 5m bars so it
// matches the scanner whatever timeframe this chart is on:
//     ext = |price - session open| / (session high - session low)
// On the 1,277-trade replay, taking a signal WITH the day's move once ext was
// past ~52% earned +0.05R; everything else earned +0.72R. So a high reading is
// not a green light -- it means the with-trend entry is already spent, and the
// scanner will suppress that alert. It says nothing against a counter-move
// trade, which was the best bucket in the replay.
// Taken straight off the FORMING daily bar already read above: its open, high
// and low ARE the session's. No extra security call, no state, and identical
// on every chart timeframe. (A hand-rolled 5m version using `var` inside
// request.security silently collapsed to the current bar and read 0% all day --
// this formulation has nothing to get wrong.)
sRng = hf_D - lf_D
sExt = sRng > 0 ? math.abs(c_D - o_D) / sRng : na
sDir = c_D > o_D ? 1 : c_D < o_D ? -1 : 0

// ---- chart-TF context metrics (computed every bar; ta.* must be global) ----
// Choppiness Index: >61.8 = choppy/ranging, <38.2 = trending.
_chopRange = ta.highest(high, chopLen) - ta.lowest(low, chopLen)
_chop = _chopRange > 0 ? 100 * math.log10(math.sum(ta.tr(true), chopLen) / _chopRange) / math.log10(chopLen) : na
// Relative volume: current bar vs its own N-bar average.
_volAvg = ta.sma(volume, volLen)
_volRatio = _volAvg > 0 ? volume / _volAvg : na
// Range vs ATR: this bar's true range as a multiple of average true range.
_atr = ta.atr(atrLen)
_atrRatio = _atr > 0 ? ta.tr(true) / _atr : na

// ---- session clock -----------------------------------------------------------
// Kept only because the RVOL block below uses it. The PM VOL row that used to
// live here was removed: pre-market volume tested FLAT as a trade filter (44%
// entering at the open, 48% at 09:45, against a 46% baseline), so it was a row
// that never earned its line.
pmv_tmin  = hour(time, syminfo.timezone) * 60 + minute(time, syminfo.timezone)
pmv_newD  = ta.change(time("D")) != 0

// ---- session volume pace -----------------------------------------------------
// Today's cumulative RTH volume against the average cumulative volume at the SAME
// point of the session over recent days. A linear pro-rata was tried first and is
// badly biased: volume is U-shaped, so at 10:00 roughly 19% of the day has traded
// while a linear model credits only 9%, and the row read ~1.8x on an ordinary
// morning. This version learns the shape per symbol and per timeframe, so 1.0x
// means "normal for this time of day" at every hour.
rvp_inRTH = pmv_tmin >= 570 and pmv_tmin < 960
var float rvp_cur  = 0.0
var int   rvp_i    = -1
var array<float> rvp_prof = array.new_float(420, na)
if pmv_newD
    rvp_cur := 0.0
    rvp_i   := -1
if rvp_inRTH
    rvp_cur += volume
    rvp_i   += 1
rvp_slot  = rvp_i >= 0 and rvp_i < 420 ? rvp_i : -1
rvp_prior = rvp_slot >= 0 ? array.get(rvp_prof, rvp_slot) : na
rvp_ratio = rvp_slot >= 0 and not na(rvp_prior) and rvp_prior > 0 ? rvp_cur / rvp_prior : na
rvp_done  = pmv_tmin >= 960
// update AFTER reading, so the comparison only ever uses prior sessions
if barstate.isconfirmed and rvp_slot >= 0
    array.set(rvp_prof, rvp_slot, na(rvp_prior) ? rvp_cur : rvp_prior * 0.9 + rvp_cur * 0.1)
rvp_ok      = timeframe.isintraday and not na(rvp_ratio)
var bool rvp_fired = false
if pmv_newD
    rvp_fired := false
rvp_atCheck = rvp_ok and pmv_tmin >= rvolAlertMin and not rvp_fired
rvp_fire    = rvp_atCheck and rvp_ratio >= rvolAlertX
if barstate.isconfirmed and rvp_atCheck
    rvp_fired := true

// =========================================================== drawing ==========
var line[]  LNS = array.new<line>()
var label[] LBS = array.new<label>()

f_clear() =>
    for l in LNS
        line.delete(l)
    array.clear(LNS)
    for lb in LBS
        label.delete(lb)
    array.clear(LBS)

// ---- merge buffer: one entry per PRICE; same-price texts join with " · " ----
// First push at a price wins the color/style/width, so push in priority
// order: triggers, scale lines, stops, DEEP plan, then rungs.
var float[]  mP = array.new<float>()
var string[] mT = array.new<string>()
var color[]  mC = array.new<color>()
var int[]    mS = array.new<int>()      // 0 solid / 1 dashed / 2 dotted
var int[]    mW = array.new<int>()

f_push(p, txt, col, sty, w) =>
    eps = math.max(syminfo.mintick * 2, close * 0.0005)
    idx = -1
    if array.size(mP) > 0
        for i = 0 to array.size(mP) - 1
            if math.abs(array.get(mP, i) - p) <= eps
                idx := i
                break
    if idx == -1
        array.push(mP, p)
        array.push(mT, txt)
        array.push(mC, col)
        array.push(mS, sty)
        array.push(mW, w)
    else
        array.set(mT, idx, array.get(mT, idx) + "  ·  " + txt)

// Compact mode drops the price from label text: the line already sits at that
// price and the axis prints it, so repeating it is pure width.
f_px(p) => compactLbl ? "" : " " + str.tostring(p, format.mintick)

// NOTE: this script deliberately draws NO setup lines and NO runway rungs.
// Trigger / stop / +1R and the untouched higher-TF rungs used to be drawn as
// full-width rays with text labels; they were the noisiest thing here and the
// alert message already carries every one of those numbers. The levels are
// still computed above -- they gate the T2 marker and the alert -- they are
// just not drawn. The only lines left are the F2D-Deep plan.

if barstate.islast
    f_clear()
    array.clear(mP)
    array.clear(mT)
    array.clear(mC)
    array.clear(mS)
    array.clear(mW)
    xL = bar_index - drawLen
    xR = bar_index + 12

    // ---- F2D-Deep plan (the only lines this script draws) ----
    if deepActive
        if deepSkip
            f_push(dEntry, "F2D-DEEP skip (gapped)" + f_px(dEntry), cDim, 1, 1)
        else
            f_push(dEntry, "F2D-DEEP long entry" + f_px(dEntry) +
                 "  day " + str.tostring(dSince, "#") + "/2", cDeep, 0, 2)
            f_push(dStop, "DEEP stop" + f_px(dStop), cBear, 0, 1)
            if showManage
                f_push(dEntry + deepR, "DEEP +1R → BE" + f_px(dEntry + deepR), cAmber, 2, 1)
                f_push(dTgt, "DEEP runner" + f_px(dTgt), cDeep, 2, 1)

    // ---- draw the merged buffer ----
    if array.size(mP) > 0
        for i = 0 to array.size(mP) - 1
            p   = array.get(mP, i)
            sty = array.get(mS, i)
            ls  = sty == 0 ? line.style_solid : sty == 1 ? line.style_dashed : line.style_dotted
            l = line.new(xL, p, xR, p, xloc = xloc.bar_index, color = array.get(mC, i),
                 style = ls, width = array.get(mW, i))
            array.push(LNS, l)
            lb = label.new(xR, p, array.get(mT, i), xloc = xloc.bar_index,
                 style = label.style_label_left, color = color.new(color.black, 100),
                 textcolor = array.get(mC, i), size = labelSize)
            array.push(LBS, lb)

// --------------------------------------------------------- FTFC table ---------
// f_row MUST live at global scope -- Pine forbids function definitions inside
// an if block.
var table tbl = na
f_row(i, name, d) =>
    table.cell(tbl, 0, i, name, text_color = cDim, bgcolor = #18212c, text_size = tblSize)
    table.cell(tbl, 1, i, d == 1 ? "▲" : d == -1 ? "▼" : "—",
         text_color = d == 1 ? cBull : d == -1 ? cBear : cDim, bgcolor = #18212c, text_size = tblSize)

if showFTFC and barstate.islast
    pos = tblPos == "Top Right" ? position.top_right : tblPos == "Top Left" ? position.top_left : tblPos == "Bottom Right" ? position.bottom_right : position.bottom_left
    if na(tbl)
        tbl := table.new(pos, 2, 7, border_width = 1)
    table.cell(tbl, 0, 0, "FTFC", text_color = color.white, bgcolor = #243040, text_size = tblSize)
    dirBull = f_aligned(1)
    dirBear = f_aligned(-1)
    lead = dirBull >= dirBear ? 1 : -1
    table.cell(tbl, 1, 0, (lead == 1 ? str.tostring(dirBull) : str.tostring(dirBear)) + "/5",
         text_color = lead == 1 ? cBull : cBear, bgcolor = #243040, text_size = tblSize)
    f_row(1, "1H", d60)
    f_row(2, "2H", d120)
    f_row(3, "4H", d240)
    f_row(4, "1D", dD)
    f_row(5, "1W", dW)

// ----------------------------------------------------- context table ----------
// Developing 4H and 1D sequences (bar-before · last-closed · forming) +
// chart-TF read on choppiness, relative volume, and range vs ATR.
var table seqTbl = na
if showSeq and barstate.islast
    posS = seqPos == "Top Right" ? position.top_right : seqPos == "Top Left" ? position.top_left : seqPos == "Bottom Right" ? position.bottom_right : seqPos == "Bottom Left" ? position.bottom_left : seqPos == "Middle Right" ? position.middle_right : position.middle_left
    if na(seqTbl)
        seqTbl := table.new(posS, 2, 5, border_width = 1)
    chopTxt = na(_chop) ? "—" : str.tostring(_chop, "#") + (_chop > 61.8 ? " chop" : _chop < 38.2 ? " trend" : " mix")
    chopCol = na(_chop) ? cDim : _chop > 61.8 ? cAmber : _chop < 38.2 ? cBull : cDim
    volTxt  = na(_volRatio) ? "—" : str.tostring(_volRatio, "#.0") + "× avg"
    volCol  = na(_volRatio) ? cDim : _volRatio >= 1.5 ? cBull : _volRatio < 0.7 ? cBear : cDim
    atrTxt  = na(_atrRatio) ? "—" : str.tostring(_atrRatio, "#.0") + "× ATR"
    atrCol  = na(_atrRatio) ? cDim : _atrRatio >= 1.2 ? cAmber : _atrRatio < 0.8 ? cDim : color.new(#c4b5fd, 0)
    table.cell(seqTbl, 0, 0, "CHOP", text_color = cDim, bgcolor = #18212c, text_size = tblSize)
    table.cell(seqTbl, 1, 0, chopTxt, text_color = chopCol, bgcolor = #18212c, text_size = tblSize)
    table.cell(seqTbl, 0, 1, "VOL", text_color = cDim, bgcolor = #18212c, text_size = tblSize)
    table.cell(seqTbl, 1, 1, volTxt, text_color = volCol, bgcolor = #18212c, text_size = tblSize)
    table.cell(seqTbl, 0, 2, "ATR", text_color = cDim, bgcolor = #18212c, text_size = tblSize)
    table.cell(seqTbl, 1, 2, atrTxt, text_color = atrCol, bgcolor = #18212c, text_size = tblSize)
    // Gate 4 readout: how much of the day is already spent, and which way.
    arrow  = sDir > 0 ? " ↑" : sDir < 0 ? " ↓" : ""
    extTxt = na(sExt) ? "—" : str.tostring(sExt * 100, "#") + "%" + arrow +
         (sExt >= maxSessExt ? "  late" : "  early")
    extCol = na(sExt) ? cDim : sExt >= maxSessExt ? cBear : cBull
    table.cell(seqTbl, 0, 3, "EXT", text_color = cDim, bgcolor = #18212c, text_size = tblSize)
    table.cell(seqTbl, 1, 3, extTxt, text_color = extCol, bgcolor = #18212c, text_size = tblSize)
    // Session volume pace. Green = today is genuinely busy for the time of day.
    rvpTxt = not timeframe.isintraday ? "intraday only" : not rvp_ok ? "n/a" : str.tostring(rvp_ratio, "#.0") + (rvp_done ? "x day" : "x pace")
    rvpCol = not rvp_ok ? cDim : rvp_ratio >= 1.5 ? cBull : rvp_ratio >= 1.0 ? color.new(#c4b5fd, 0) : rvp_ratio < 0.7 ? cBear : cDim
    table.cell(seqTbl, 0, 4, "RVOL", text_color = cDim, bgcolor = #18212c, text_size = tblSize)
    table.cell(seqTbl, 1, 4, rvpTxt, text_color = rvpCol, bgcolor = #18212c, text_size = tblSize)

// ------------------------------------------------ Tier-2 confirmation ---------
// A chart-TF close through an armed trigger. Gated (default) = min risk +
// nearest rung + 4H/1D continuity + FTFC, i.e. what the scanner would alert.
gAB = okAB and d240 == 1  and dD == 1  and f_aligned(1)  >= minFtfc
gAS = okAS and d240 == -1 and dD == -1 and f_aligned(-1) >= minFtfc
gBB = okBB and d240 == 1  and dD == 1  and f_aligned(1)  >= minFtfc
gBS = okBS and d240 == -1 and dD == -1 and f_aligned(-1) >= minFtfc

pAB = t2Gated ? gAB : aB
pAS = t2Gated ? gAS : aS
pBB = t2Gated ? gBB : bB
pBS = t2Gated ? gBS : bS

t2AB = showT2 and pAB and barstate.isconfirmed and close > aTB and close[1] <= aTB and inLabelWindow
t2AS = showT2 and pAS and barstate.isconfirmed and close < aTS and close[1] >= aTS and inLabelWindow
t2BB = showT2 and pBB and barstate.isconfirmed and close > bTB and close[1] <= bTB and inLabelWindow
t2BS = showT2 and pBS and barstate.isconfirmed and close < bTS and close[1] >= bTS and inLabelWindow

t2Bull = t2AB or t2BB
t2Bear = t2AS or t2BS

// label.new (not plotshape) so the marker respects the size selector --
// plotshape's size argument only accepts a compile-time constant.
if t2Bull
    label.new(bar_index, na, "T2", yloc = yloc.belowbar, style = label.style_label_up,
         color = cBull, textcolor = color.black, size = labelSize)
if t2Bear
    label.new(bar_index, na, "T2", yloc = yloc.abovebar, style = label.style_label_down,
         color = cBear, textcolor = color.black, size = labelSize)

alertcondition(t2Bull, "Tier-2 bull confirmation", "bar closed through a gated bull trigger")
alertcondition(t2Bear, "Tier-2 bear confirmation", "bar closed through a gated bear trigger")
alertcondition(rvp_fire, "RVOL elevated at check time",
     "Session volume pace is at or above the threshold at the check time. This name is BUSY today: historically ~62% of these finish the day >=1.5x normal volume and ~91% finish >=1.2x, against a 6% base rate. It says nothing about DIRECTION -- RVOL tracks range, not return sign. Use it to confirm a setup you already have, not to go looking for one.")
alertcondition(deepActive and dSince == 0 and not deepSkip, "F2D-Deep entry day",
     "F2D-Deep long entry window is open")

// Rich dynamic alerts: fire via an "Any alert() function call" alert. The
// message carries formation, trigger, stop, +1R, FTFC, and which nominator.
f_alertMsg(sideTxt, pat, trig, stp, risk, dirSign, tfN) =>
    syminfo.ticker + " " + timeframe.period + " " + sideTxt + " " + pat +
     " @" + str.tostring(close, format.mintick) +
     " · trig " + str.tostring(trig, format.mintick) +
     " · stop " + str.tostring(stp, format.mintick) +
     " · +1R "  + str.tostring(dirSign > 0 ? trig + risk : trig - risk, format.mintick) +
     " · FTFC " + str.tostring(f_aligned(dirSign)) + "/5" +
     " · setup " + tfN

if t2AB
    alert(f_alertMsg("LONG",  aPB, aTB, aSB, aRB,  1, "4H"), alert.freq_once_per_bar_close)
if t2AS
    alert(f_alertMsg("SHORT", aPS, aTS, aSS, aRS, -1, "4H"), alert.freq_once_per_bar_close)
if t2BB
    alert(f_alertMsg("LONG",  bPB, bTB, bSB, bRB,  1, "1D"), alert.freq_once_per_bar_close)
if t2BS
    alert(f_alertMsg("SHORT", bPS, bTS, bSS, bRS, -1, "1D"), alert.freq_once_per_bar_close)
